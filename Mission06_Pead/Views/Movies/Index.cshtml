@model IEnumerable<Mission06_Pead.Models.Movie>
@{
    ViewData["Title"] = "Movie Collection";
}

<h1 class="mb-3">Movie Collection</h1>

<div class="mb-3">
    <a asp-controller="Movies" asp-action="Add" class="btn btn-primary">Add New Movie</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Year</th>
                <th>Director</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Copied To Plex</th>
                <th>Lent To</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@(movie.Category?.CategoryName ?? "")</td>
                <td>@movie.Year</td>
                <td>@movie.Director</td>
                <td>@movie.Rating</td>
                <td>@(movie.Edited == true ? "Yes" : "No")</td>
                <td>@(movie.CopiedToPlex == true ? "Yes" : "No")</td>
                <td>@movie.LentTo</td>
                <td>@movie.Notes</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                    <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
