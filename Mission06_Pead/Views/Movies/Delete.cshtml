@model Mission06_Pead.Models.Movie
@{
    ViewData["Title"] = "Delete Movie";
}

<h1 class="mb-3 text-danger">Delete Movie</h1>

<div class="alert alert-warning shadow-sm" role="alert">
    Are you sure you want to delete <strong>@Model.Title</strong>?
</div>

<dl class="row">
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category?.CategoryName</dd>

    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Year</dd>

    <dt class="col-sm-2">Director</dt>
    <dd class="col-sm-10">@Model.Director</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
